[% macro groups(name) %]
    groups:
      [[ name ]]:
        patterns: ["*"]
        update-types: ["minor", "patch"]
      [[ name ]]-major:
        patterns: ["*"]
        update-types: ["major"]
      [[ name ]]-security:
        applies-to: security-updates
        patterns: ["*"]
[% endmacro %]
# Per ecosystem per month: one PR for minor and patch updates, one for major
# updates, and one for security updates. Strict required checks rerun CI on
# every open PR after each merge, so fewer PRs means fewer runs. A major group
# can bundle a breaking change: fix it in the group PR, or add an ignore entry
# for that version.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: monthly
[[ groups("actions") ]]
  # uv.lock holds every Python pin with hashes. lockfile-only: Dependabot
  # moves uv.lock, not the ranges in pyproject.toml.
  - package-ecosystem: uv
    directory: /
    schedule:
      interval: monthly
    versioning-strategy: lockfile-only
[[ groups("python") ]]
  # Hook revs are commit hashes with a `# frozen:` tag comment.
  - package-ecosystem: pre-commit
    directory: /
    schedule:
      interval: monthly
    groups:
      hooks:
        patterns: ["*"]
[% if 'node' in languages %]
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: monthly
[[ groups("npm") ]]
[% endif %]
